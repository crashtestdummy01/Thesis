<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="BFT_MH1_MLP_BD" params="prefix">
    <link
      name="${prefix}_mounting">
      <inertial>
        <origin
          xyz="-1.1834E-05 -0.001718 0.016832"
          rpy="0 0 0" />
        <mass
          value="0.31844" />
        <inertia
          ixx="0.00019906"
          ixy="2.9369E-10"
          ixz="7.8769E-10"
          iyy="0.00020009"
          iyz="2.9785E-07"
          izz="0.00034267" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0.0"
          rpy="0.0 0 0.0" />
        <geometry>
          <mesh
            filename="package://bota_driver/meshes/gen_a/one_series/pixone_t60/PixONE_T60.dae" />
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0.02225"
          rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.0415" length="0.0445"/>
        </geometry>
      </collision>
      <collision>
        <origin
          xyz="0 -0.0465 0.015"
          rpy="0 0 0" />
        <geometry>
          <box size="0.018 0.015 0.027" />
        </geometry>
      </collision>
      <collision>
        <origin
          xyz="0 -0.0665 0.015"
          rpy="1.5708 0 0" />
        <geometry>
          <cylinder radius="0.0065" length="0.032"/>
        </geometry>
      </collision>
    </link>

    <link
      name="${prefix}_wrench">
      <inertial>
        <origin
          xyz="-9.92E-05 -5.1511E-06 -0.012601"
          rpy="0 0 0" />
        <mass
          value="0.1522" />
        <inertia
          ixx="4.3975E-05"
          ixy="7.7798E-11"
          ixz="1.3264E-07"
          iyy="4.3577E-05"
          iyz="-1.1015E-08"
          izz="6.8828E-05" />
      </inertial>
    </link>

    <joint
      name="${prefix}_mounting_to_wrench"
      type="fixed">
      <origin
        xyz="0 0 0.0415"
        rpy="0 0 0" />
      <parent
        link="${prefix}_mounting" />
      <child
        link="${prefix}_wrench" />
    </joint>

  </xacro:macro>
</robot>