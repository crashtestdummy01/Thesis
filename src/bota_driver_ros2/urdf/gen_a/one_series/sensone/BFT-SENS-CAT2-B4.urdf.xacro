<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="BFT_SENS_CAT2_B4" params="prefix">

    <link name="${prefix}_mounting">
      <inertial>
        <origin xyz="-0.00011559 0.00060052 0.010067" rpy="0 0 0" />
        <mass value="0.15393" />
        <inertia
          ixx="4.907E-05" ixy="3.2541E-08" ixz="-1.0415E-07"
          iyy="5.5735E-05" iyz="1.3709E-07"
          izz="9.0228E-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://bota_driver/meshes/gen_a/one_series/sensone/SensONE.dae" />
        </geometry>
        <!-- No <material> here so the colors embedded in the DAE are used. -->
      </visual>
      <!-- Main sensor body -->
      <collision>
        <origin xyz="0 0 0.011" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.035" length="0.028" />
        </geometry>
      </collision>
      <!-- Tool-side flange -->
      <collision>
        <origin xyz="0 0 0.03" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.0315" length="0.01" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0.051 0.0115" rpy="1.5708 0 0" />
        <geometry>
          <cylinder radius="0.0065" length="0.032" />
        </geometry>
      </collision>
    </link>

    <!-- Frame in which the sensor reports the wrench (tool-side face) -->
    <link name="${prefix}_wrench">
      <inertial>
        <!-- TODO: placeholder from SER-M8 -->
        <origin xyz="-0.00018335 -3.3341E-07 -0.0070612" rpy="0 0 0" />
        <mass value="0.08253" />
        <inertia
          ixx="2.2674E-05" ixy="-3.9222E-12" ixz="4.8952E-08"
          iyy="2.2294E-05" iyz="4.0972E-11"
          izz="4.0919E-05" />
      </inertial>
    </link>

    <joint name="${prefix}_mounting_to_wrench" type="fixed">
      <origin xyz="0 0 0.035" rpy="0 0 0" />
      <parent link="${prefix}_mounting" />
      <child link="${prefix}_wrench" />
    </joint>

    <!-- Mechanical reference frames on the sensor body -->
    <link name="${prefix}_mech1" />
    <joint name="${prefix}_mounting_to_mech1" type="fixed">
      <origin xyz="0 -0.032879 0.0105" rpy="1.5708 0 0" />
      <parent link="${prefix}_mounting" />
      <child link="${prefix}_mech1" />
    </joint>

    <link name="${prefix}_mech2" />
    <joint name="${prefix}_mounting_to_mech2" type="fixed">
      <origin xyz="0.032879 0 0.0105" rpy="1.5708 0 1.5708" />
      <parent link="${prefix}_mounting" />
      <child link="${prefix}_mech2" />
    </joint>

  </xacro:macro>
</robot>